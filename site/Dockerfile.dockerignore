# site/Dockerfile builds from the repository root; it needs the site, the
# code cmd/site and cmd/release-mirror read, the docs and the dashboard in
# web/ for the live demo (whose art the site uses too), without anything
# installed or built.
*
!go.mod
!go.sum
!cmd/site/
!cmd/release-mirror/
!internal/
!site/
!web/
web/node_modules/
web/dist/
web/dist-demo/
!README.md
!CHANGELOG.md
!CONTRIBUTING.md
!SECURITY.md
!docs/
site/dist/
site/tools/thumbnails/node_modules/
site/tools/thumbnails/dist/
**/.DS_Store
